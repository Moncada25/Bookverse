---
const base = import.meta.env.BASE_URL;
---

<section class="full-box cover dashboard-sideBar">
  <div class="full-box dashboard-sideBar-bg btn-menu-dashboard"></div>
  <div class="full-box dashboard-sideBar-ct">
    <!--SideBar Title -->
    <div class="full-box text-uppercase text-center text-titles dashboard-sideBar-title">
      Bookverse
    </div>
    <!-- SideBar User info -->
    <div class="full-box dashboard-sideBar-UserInfo">
      <figure class="full-box">
        <img id="avatar" src={base + "assets/avatars/Male1Avatar.png"} alt="" />
        <h4 class="text-center text-titles">
          <span id="display-name"></span>
        </h4>
        <h5 class="text-center text-titles">
          <span id="role"></span>
        </h5>
      </figure>

      <ul class="full-box list-unstyled text-center">
        <li>
          <a
            href={base + "mydata/"}
            aria-label="Mis datos"
            data-title="Mis datos"
          >
            <i class="zmdi zmdi-account-circle"></i>
          </a>
        </li>
        <li>
          <a
            href={base + "myaccount/"}
            aria-label="Mi cuenta"
            data-title="Mi cuenta"
          >
            <i class="zmdi zmdi-settings"></i>
          </a>
        </li>
        <li>
          <a
            href={base + "login/"}
            aria-label="Cerrar sesión"
            data-title="Cerrar sesión"
            class="btn-exit-system"
          >
            <i class="zmdi zmdi-power"></i>
          </a>
        </li>
      </ul>
    </div>
    <!-- SideBar Menu -->
    <ul class="list-unstyled full-box dashboard-sideBar-Menu">
      <li data-admin>
        <a href={base + "home/"}>
          <i class="zmdi zmdi-view-dashboard zmdi-hc-fw"></i> Dashboard
        </a>
      </li>
      <li data-admin>
        <a href="#!" class="btn-sideBar-SubMenu">
          <i class="zmdi zmdi-case zmdi-hc-fw"></i> Administración{" "}
          <i class="zmdi zmdi-caret-down pull-right"></i>
        </a>
        <ul class="list-unstyled full-box">
          <li>
            <a href={base + "categorylist/"}>
              <i class="zmdi zmdi-labels zmdi-hc-fw"></i> Categorías
            </a>
          </li>
          <li>
            <a href={base + "book/"}>
              <i class="zmdi zmdi-book zmdi-hc-fw"></i> Nuevo libro
            </a>
          </li>
        </ul>
      </li>
      <li data-admin>
        <a href="#!" class="btn-sideBar-SubMenu">
          <i class="zmdi zmdi-account-add zmdi-hc-fw"></i> Usuarios{" "}
          <i class="zmdi zmdi-caret-down pull-right"></i>
        </a>
        <ul class="list-unstyled full-box">
          <li>
            <a href={base + "adminlist/"}>
              <i class="zmdi zmdi-account zmdi-hc-fw"></i> Administradores
            </a>
          </li>
          <li>
            <a href={base + "clientlist/"}>
              <i class="zmdi zmdi-male-female zmdi-hc-fw"></i> Clientes
            </a>
          </li>
        </ul>
      </li>

      <li>
        <a href={base + "catalog/all/"}>
          <i class="zmdi zmdi-book-image zmdi-hc-fw"></i> Catálogo de libros
        </a>
      </li>
      <li>
        <a href={base + "tasklist/"}>
          <i class="zmdi zmdi-lamp zmdi-hc-fw"></i> Backlog
        </a>
      </li>
      <li>
        <a href={base + "feedback/"}>
          <i class="zmdi zmdi-github-alt zmdi-hc-fw"></i> Feedback
        </a>
      </li>
    </ul>
  </div>
</section>
