---
import Layout from "../layouts/Layout.astro";
---

<Layout page="feedback">
  <br />
  <div class="container-fluid">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title text-center">BOOKVERSE</h3>
      </div>
      <div class="panel-body">
        <form
          method="post"
          data-form="save"
          class="local-form"
          autocomplete="off"
        >
          <div class="row">
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/Bookverse/zipball/main"
                  id="linkBookverseZIP"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  Code ZIP
                </a>
              </p>
            </div>
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/"
                  target="_blank"
                  id="linkGitHub"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  GitHub
                </a>
              </p>
            </div>
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/Bookverse/tarball/main"
                  id="linkBookverseTAR"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  Code TAR
                </a>
              </p>
            </div>
          </div>

          <div class="row">
            <div class="col-xs-12 col-md-8 col-md-offset-2">
              <div class="form-group label-floating">
                <span class="control-label">
                  ¿Qué te parece? ¡Déjanos tu feedback!
                </span>
                <textarea
                  class="form-control"
                  name="comentario-bookverse"
                  id="comentario-bookverse"
                  required=""
                ></textarea>
              </div>
            </div>
            <div class="col-xs-12">
              <p class="text-center">
                <button type="submit" class="btn btn-info btn-raised btn-sm">
                  <i class="zmdi zmdi-email"></i> &nbsp; Preparar issue
                </button>
              </p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="container-fluid">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title text-center">PACKAPPS</h3>
      </div>
      <div class="panel-body">
        <form
          method="post"
          data-form="save"
          class="local-form"
          autocomplete="off"
        >
          <div class="row">
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/PackApps/zipball/trunk"
                  id="linkPackAppsZIP"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  Code ZIP
                </a>
              </p>
            </div>
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/PackApps"
                  target="_blank"
                  id="linkPackApps"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  App
                </a>
              </p>
            </div>
            <div class="col-xs-4">
              <p class="text-center">
                <a
                  href="https://github.com/Moncada25/PackApps/tarball/trunk"
                  id="linkPackAppsTAR"
                  class="btn btn-warning btn-raised btn-sm"
                >
                  Code TAR
                </a>
              </p>
            </div>
          </div>

          <div class="row">
            <div class="col-xs-12 col-md-8 col-md-offset-2">
              <div class="form-group label-floating">
                <span class="control-label">
                  ¿Qué te parece? ¡Déjanos tu feedback!
                </span>
                <textarea
                  class="form-control"
                  name="comentario-packapps"
                  id="comentario-packapps"
                  required=""
                ></textarea>
              </div>
            </div>
            <div class="col-xs-12">
              <p class="text-center">
                <button type="submit" class="btn btn-info btn-raised btn-sm">
                  <i class="zmdi zmdi-email"></i> &nbsp; Preparar issue
                </button>
              </p>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>
