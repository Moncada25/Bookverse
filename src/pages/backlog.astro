---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout page="backlog">
  <br />
  <div class="container-fluid">
    <ul class="breadcrumb breadcrumb-tabs">
      <li>
        <a href={base + "task/"} class="btn btn-info">
          <i class="zmdi zmdi-plus"></i> &nbsp; NUEVA TAREA
        </a>
      </li>
      <li>
        <a href={base + "tasklist/"} class="btn btn-success">
          <i class="zmdi zmdi-format-list-bulleted"></i> &nbsp; MIS TAREAS
        </a>
      </li>
      <li>
        <a href={base + "backlog/"} class="btn btn-warning">
          <i class="zmdi zmdi-search"></i> &nbsp; BACKLOG
        </a>
      </li>
    </ul>
  </div>

  <!-- Panel listado de tareas -->
  <div class="container-fluid">
    <div class="panel panel-warning">
      <div class="panel-heading">
        <h3 class="panel-title">
          <i class="zmdi zmdi-format-list-bulleted"></i> &nbsp; BACKLOG
        </h3>
      </div>
      <div class="panel-body">
        <div id="results"></div>
      </div>
    </div>
  </div>
</Layout>
