---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout page="category">
  <br />
  <div class="container-fluid">
    <ul class="breadcrumb breadcrumb-tabs">
      <li>
        <a href={base + "category/"} class="btn btn-info">
          <i class="zmdi zmdi-plus"></i> &nbsp; NUEVA CATEGORÍA
        </a>
      </li>
      <li>
        <a href={base + "categorylist/"} class="btn btn-success">
          <i class="zmdi zmdi-format-list-bulleted"></i> &nbsp; LISTA DE
          CATEGORÍAS
        </a>
      </li>
    </ul>
  </div>

  <!-- Panel nueva categoria -->
  <div class="container-fluid">
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title">
          <i class="zmdi zmdi-plus"></i> &nbsp; NUEVA CATEGORÍA
        </h3>
      </div>
      <div class="panel-body">
        <form
          method="post"
          data-form="save"
          class="local-form"
          autocomplete="off"
        >
          <fieldset>
            <legend>
              <i class="zmdi zmdi-assignment-o"></i> &nbsp; Datos de la
              categoría
            </legend>
            <div class="container-fluid">
              <div class="row">
                <div class="col-xs-12 col-sm-6">
                  <div class="form-group label-floating">
                    <label class="control-label">Código *</label>
                    <input
                      pattern="[0-9]{1,7}"
                      class="form-control"
                      type="text"
                      name="codigo-cat"
                      required=""
                      maxlength="7"
                    />
                  </div>
                </div>
                <div class="col-xs-12 col-sm-6">
                  <div class="form-group label-floating">
                    <label class="control-label">Nombre *</label>
                    <input
                      pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ ]{1,30}"
                      class="form-control"
                      type="text"
                      name="nombre-cat"
                      required=""
                      maxlength="30"
                    />
                  </div>
                </div>
              </div>
            </div>
          </fieldset>
          <p class="text-center" style="margin-top: 20px;">
            <button type="submit" class="btn btn-info btn-raised btn-sm">
              <i class="zmdi zmdi-floppy"></i> Guardar
            </button>
          </p>
        </form>
      </div>
    </div>
  </div>
</Layout>
